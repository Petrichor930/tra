{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "build",
      "dependsOn": [
        "cmake"
      ],
      "command": "ninja -C 'build' ",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "make...",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "cmake",
      "command": " cmake -B 'build' -G 'Ninja' ",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "open-RTT",
      "type": "shell",
      "command": "echo 'Opening cnt terminal...' && code --wait --new-window ${workspaceFolder}",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
